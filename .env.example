# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=tucan
DB_USER=sa
DB_PASSWORD=
# Azure SQL: DB_ENCRYPT=true y DB_TRUST_SERVER_CERTIFICATE=false.
# SQL Server local con certificado autofirmado: DB_TRUST_SERVER_CERTIFICATE=true.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Orígenes del frontend separados por comas (ej. https://tucan.vercel.app,http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Ingreso directo con las cuentas de demostración (botones «Probar como...»).
DEMO_LOGIN_ENABLED=true

# Búsqueda con IA. Sin clave, la API responde con sugerencias genéricas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
