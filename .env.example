# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL. En local, la base de `docker compose up -d db`:
DATABASE_URL=postgresql://postgres:local_dev_pg@localhost:5433/churapp
# Supabase: usa la cadena «Session pooler» (Connect → Session pooler), que funciona
# por IPv4. Si la contraseña tiene símbolos (@ # / :), codifícalos (%40 %23 %2F %3A).
# DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres

# TLS hacia la base: true con proveedores gestionados (Supabase, Neon, Render); false en local.
DB_SSL=false
# Conexiones simultáneas. Los planes gratuitos admiten pocas.
DB_POOL_MAX=5

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Orígenes del frontend separados por comas (ej. https://aplicaciondeempleo.vercel.app,http://localhost:8080)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Ingreso directo con las cuentas de demostración (botones «Demo ...»).
DEMO_LOGIN_ENABLED=true

# Búsqueda con IA. Sin clave, la API responde con sugerencias genéricas.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
